---
import { SITE } from '@/site.config';
const { tags } = Astro.props;
---
<aside class="space-y-10">
  <div class="border rounded-lg p-6 text-center" style="border-color: var(--line)">
    <h3 class="font-bold text-lg mb-2">{SITE.author}</h3>
    <p class="text-sm text-[var(--ink-soft)]">{SITE.tagline}</p>
  </div>
  {tags && tags.length > 0 && (
    <div>
      <h3 class="font-bold text-lg mb-4">Tags</h3>
      <div class="flex flex-wrap gap-2">
        {tags.map(([tag, count]: [string, number]) => (
          <a href={`/tags/${tag}/`} class="tag-pill">{tag} ({count})</a>
        ))}
      </div>
      <a href="/tags/" class="inline-block mt-4 text-sm text-[var(--accent)]">See all →</a>
    </div>
  )}
</aside>
