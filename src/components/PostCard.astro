---
import { formatDate } from '@/utils/formatDate';
const { post } = Astro.props;
const cover = post.data.cover ?? null;
const coverUrl = post.data.coverUrl ?? null;
---
<article class="grid sm:grid-cols-[220px_1fr] gap-6 py-8 border-b" style="border-color: var(--line)">
  <a href={`/${post.id}/`} class="block aspect-[4/3] overflow-hidden rounded-md bg-[var(--surface)]">
    {cover ? <img src={cover.src} alt={post.data.title} class="w-full h-full object-cover" /> :
     coverUrl ? <img src={coverUrl} alt={post.data.title} class="w-full h-full object-cover" /> : null}
  </a>
  <div>
    <p class="text-xs uppercase tracking-wide text-[var(--ink-soft)] mb-2">{formatDate(post.data.date)}</p>
    <h2 class="text-2xl font-bold mb-2">
      <a href={`/${post.id}/`} class="hover:text-[var(--accent)] transition-colors">{post.data.title}</a>
    </h2>
    {post.data.excerpt && <p class="text-[var(--ink-soft)] leading-relaxed">{post.data.excerpt}</p>}
  </div>
</article>
